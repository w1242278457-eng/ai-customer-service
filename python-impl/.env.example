# LLM Provider (DeepSeek is the default; any OpenAI-compatible endpoint is supported)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000
